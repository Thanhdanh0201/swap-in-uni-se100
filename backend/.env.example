# ========================================================
# SWAPINUNI - BACKEND
# cp .env.example .env rồi điền giá trị thật. KHÔNG commit file .env.
# Lấy ở Supabase Dashboard > Project Settings.
# ========================================================

# Database > Connect > Session pooler (máy không có IPv6 thì không dùng được Direct connection)
ConnectionStrings__DefaultConnection=Host=aws-0-ap-southeast-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.your-project-ref;Password=your-db-password;SSL Mode=Require

# API Keys
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Chỉ cần nếu project còn dùng Legacy JWT secret (HS256). Project mới ký ES256, backend tự tải JWKS.
SUPABASE_JWT_SECRET=
