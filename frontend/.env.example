# Chỉ giá trị public ở biến VITE_*. Tuyệt đối không đặt service role key ở frontend.

# Supabase Dashboard > Project Settings > API: Project URL và anon/publishable key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Trình duyệt gọi API: để trống khi dev (Vite proxy /api).
VITE_API_BASE_URL=

# Server Node (SSR) gọi API trực tiếp.
API_URL=http://localhost:5180

# URL công khai của site, dùng cho og:url.
SITE_URL=http://localhost:5174
